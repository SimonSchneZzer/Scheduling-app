{
  "name": "scheduling-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --filter @scheduling-app/web dev",
    "build": "pnpm --filter @scheduling-app/web build",
    "db:generate": "pnpm --filter @scheduling-app/web db:generate",
    "db:migrate": "pnpm --filter @scheduling-app/web db:migrate",
    "db:seed": "pnpm --filter @scheduling-app/web db:seed",
    "db:validate": "pnpm --filter @scheduling-app/web db:validate",
    "lint": "pnpm --filter @scheduling-app/web lint",
    "test": "pnpm --filter @scheduling-app/web test",
    "typecheck": "pnpm --filter @scheduling-app/web typecheck"
  }
}
